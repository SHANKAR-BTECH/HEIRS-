# HEIRS frontend environment template
# Copy to .env to override values for local development.

# Data mode selector.
#   api  -> full-stack mode: React -> Spring Boot -> MySQL (default)
#   demo -> self-contained frontend demo: bundled + browser-local data,
#           no backend required (used for Vercel frontend-only deploys)
# VITE_DATA_MODE=demo
VITE_DATA_MODE=api

# The backend REST API base URL. Defaults to the local Spring Boot server.
# Only used in api mode; may be omitted in demo mode.
VITE_API_BASE_URL=http://127.0.0.1:8080